{
  "name": "room-booking-api",
  "version": "1.0.0",
  "description": "Room Booking API (Zadanie 04): authentication, authorization i konfiguracja",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose stop",
    "db:psql": "docker exec -it roombooking-db psql -U postgres -d roombooking",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "double-booking": "node scripts/double-booking.js",
    "tamper-token": "node scripts/tamper-token.js",
    "parallel-register": "node scripts/parallel-register.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  }
}