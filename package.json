{
  "name": "room-booking-api",
  "version": "1.0.0",
  "description": "Room Booking API (Zadanie 05): testy, Docker Compose, eventy i CI",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop",
    "db:psql": "docker compose exec db psql -U roombooking -d roombooking",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed": "knex seed:run",
    "double-booking": "node scripts/double-booking.js",
    "tamper-token": "node scripts/tamper-token.js",
    "parallel-register": "node scripts/parallel-register.js",
    "test": "jest --runInBand --silent",
    "test:unit": "jest tests/unit --silent",
    "test:integration": "jest --runInBand --silent tests/integration",
    "docker:up": "docker compose up --build",
    "docker:seed": "docker compose exec api npx knex seed:run"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
