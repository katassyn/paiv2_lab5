# Skopiuj do pliku .env (cp .env.example .env) i ustaw własne wartości.
# Losowy sekret: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"

# Baza w Dockerze (docker-compose.yml)
DB_USER=roombooking
DB_PASSWORD=change-me
DB_NAME=roombooking

# Uruchamianie API bez Dockera (npm run dev): baza z Compose na porcie 5433
DATABASE_URL=postgres://roombooking:change-me@localhost:5433/roombooking
# Testy (npm test): osobna baza testowa, tworzona przez docker/init-test-db.sql
TEST_DATABASE_URL=postgres://roombooking:change-me@localhost:5433/roombooking_test

NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
