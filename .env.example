# Skopiuj do pliku .env i uzupełnij własnymi wartościami.
# Losowy sekret: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5433/roombooking
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
# REPOSITORY=memory   # repositories in-memory zamiast PostgreSQL
